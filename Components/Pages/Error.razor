@page "/Error"
@attribute [AllowAnonymous]

<PageTitle>Fehler — SilentFlow</PageTitle>

<div class="login-wrapper">
    <div class="login-box">
        <div class="login-title">SilentFlow</div>
        <p style="color: #ccc; text-align: center; margin-top: 1rem;">
            Ein unerwarteter Fehler ist aufgetreten.<br />
            Bitte die Seite neu laden oder es später erneut versuchen.
        </p>
        <a href="/" style="display:block; text-align:center; margin-top:1.5rem; color:#aaa;">← Zurück</a>
    </div>
</div>
